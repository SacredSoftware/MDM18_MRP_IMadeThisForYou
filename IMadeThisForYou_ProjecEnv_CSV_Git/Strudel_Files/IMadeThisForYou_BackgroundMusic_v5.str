//------Composition Work - Test 2----------------//

//------Project Setup----------------------------//
setcps(1/32)

//------PROGRESSION_1--------------------------//
      //------PROGRESSION_1_CoreElements--------------//
      const prog1_mainChord = note(`
      [C2, G2, D3, E3]
      [G1, D2, B2, C3]
      [A1, E2, A2, C3] 
      [F1, C2, G2, A2]
      `)

      const prog1_mainArp = note(`
      [C2 G2 D3 E3]*4
      [G1 D2 B2 C3]*4
      [A1 E2 A2 C3]*4
      [F1 C2 G2 A2]*4
      `)

      const prog1_bass = note(`
      [C1 G1 A1 F1]
      `)
        
      //-----PPROGRESSION_1_Arpeggio_Melodies------------//
      //accent melodies that are continous arpeggios - built for Player_accMel_arp
      const prog1_arpMel_1 = note(`
      [[C2 G2 D3 E3]
      [G1 D2 B2 C3]
      [A1 E2 A2 C3]
      [F1 C2 G2 A2]]*16
      `)

      const prog1_arpMel_2 = note(`
      [C3 D3 E3 G3 A3 C4 G5 A4]*32
      `)

      const prog1_arpMel_3 = note(`
      [[1 5 6 2]
      [1 6 2 5]
      [1 3 6 2]
      [1 6 2 5]]*8
      `)
      .scale("c3: major")

      const prog1_arpMel_4 = note(`
      [[1 15 5 7]
      [3 15 7 5]
      [13 3 5 7]
      [1 3 17 19]]*16
      `)
      .scale("c2:major")

      //-----PROGRESSION_1_Staccato_Melodies------------/
      //accent melodies that are staccato or synchopated in nature - built for Player_accMel_staccato
      const prog1_staccMel_1 = note(`
      [C5 ~ C5 ~ ~ ~ G5 E5 ~ ~ ~ ~]*16
      `)

      const prog1_staccMel_2 = note(`
      [[C5 C5 ~ ~ c5 c5 ~ ~ ]
      [c5 c5 ~ ~ ~ ~ c6 b5 e5]
      [C5 C5 ~ ~ c5 c5 ~ ~ ]
      [c5 c5 ~ ~ ~ ~ ~ ~ ~]]*8
      `)

      const prog1_staccMel_3 = note(`
      [[E5 ~ ~ ~ ~ ~ ~ E5 ]
      [G5 ~ ~ ~ ~ ~ ~ E5 ]
      [G5 ~ ~ ~ ~ ~ ~ E5 ]
      [~ ~ ~ ~ ~ ~ ~ ~ ]
      [~ ~ ~ e5 d5 c5 ~ ~]]*8
      `)

      //-----PROGRESSION_1_Sustained_Melodies------------/
      //accent melodies that are sustained or hold for half/whole notes - built for Player_accMel_sustained
      const prog1_susMel_1 = note(`
      [C4 D5 C4 C5 C4 E5 C4 D5]*8
      `)

      const prog1_susMel_2 = note(`
      [D4 E4 B4 C5]
      [C4 E4 A4 D4]
      [D4 E4 B4 C5]
      [D4 F4 A4 G4]
      `)


//------PROGRESSION_2--------------------------//
      //------PROGRESSION_2_CoreElements--------------//
      const prog2_mainChord = note(`
      [D1, F2, D3, E3]
      [E1, G2, D3, E3]
      [F1, A2, E3, F3] 
      [C1, E2, C3, E3]
      `)

      const prog2_mainArp = note(`
      [D2 F2 D3 E3]*4
      [E2 G2 D3 E3]*4
      [F2 A2 E3 F3]*4
      [C2 E2 C3 E3]*4
      `)

      //-----PPROGRESSION_2_Arpeggio_Melodies------------//
      //accent melodies that are continous arpeggios - built for Player_accMel_arp
      const prog2_arpMel_1 = note(`
      [[D2 F2 D3 E3]
      [E2 G2 D3 E3]
      [F2 A2 E3 F3]
      [C2 E2 C3 E3]]*16
      `)

      const prog2_arpMel_2 = note(`
      [C3 D3 E3 G3 A3 C4 G5 A4]*32
      `)

      const prog2_arpMel_3 = note(`
      [[1 1 5 5 6 6 2 2]
      [1 6 2 5]
      [1 3 6 2]
      [1 6 2 5]]*8
      `)
      .scale("c3: major")

      const prog2_arpMel_4 = note(`
      [[1 15 5 7]
      [3 15 7 5]
      [13 3 5 7]
      [1 3 17 19]]*16
      `)
      .scale("c2:major")

      //-----PROGRESSION_2_Staccato_Melodies------------/
      //accent melodies that are staccato or synchopated in nature - built for Player_accMel_staccato
      const prog2_staccMel_1 = note(`
      [G5 G5 ~ ~ ~ ~ ~ ~ G5 E5 D5 ~]*16
      `)

      const prog2_staccMel_2 = note(`
      [G5 ~ G5 ~ ~ ~ ~ ~ F5 E5 D5 C5 ~ ]*16
      `)

      

      //-----PROGRESSION_2_Sustained_Melodies------------/
      //accent melodies that are sustained or hold for half/whole notes - built for Player_accMel_sustained
      const prog2_susMel_1 = note(`
      [D4 A5 D4 B5 E4 A5 D4 G5]*8
      `)

      const prog2_susMel_2 = note(`
      [D4 E4 D5 E5]
      [G4 D5 E5 [E5 D5]]
      [C5 C5 A4 D5]
      [D4 E4 E5 D5]
      `)

//-----Progression_Silent------------/
//a null variable to slot in to silence individual tracks
const prog_null = silence

//----Manipulation Parameters-----------------//
//this is where edtaible paratmeters will go for melody selection, LPF manipulation, delay manipulation, and chorus manipulation

const cpsValue = 1/32   // must match the value in setcps() above - used to convert minutes into cycle counts

// FUNCTION 1: how long each progression (1 or 2) stays active before swapping to the other
const progSwitchMinutes = 10
const progSwitchCycles = Math.round(progSwitchMinutes * 60 * cpsValue)

// FUNCTION 2: how often each accent-melody player rotates to a new option within its subgroup (or goes silent via prog_null)
const arpSwitchMinutes     = 4
const staccSwitchMinutes   = 4
const sustainSwitchMinutes = 5

const arpSwitchCycles     = Math.round(arpSwitchMinutes * 60 * cpsValue)
const staccSwitchCycles   = Math.round(staccSwitchMinutes * 60 * cpsValue)
const sustainSwitchCycles = Math.round(sustainSwitchMinutes * 60 * cpsValue)


//-----FUNCTION 1: Progression Selector-------------//
// Plays prog1's core elements for progSwitchCycles cycles, then prog2's for progSwitchCycles cycles, then loops forever.
// arrange() takes plain [cycles, pattern] pairs - no mini-notation string parsing involved.
const activeMainChord = arrange(
  [progSwitchCycles, prog1_mainChord],
  [progSwitchCycles, prog2_mainChord],
)
const activeMainArp = arrange(
  [progSwitchCycles, prog1_mainArp],
  [progSwitchCycles, prog2_mainArp],
)


//-----FUNCTION 2: Accent Melody Rotators-----------//
// Each accent player rotates through its own subgroup of melodies (plus prog_null to go silent),
// built separately per progression (since the subgroups differ in size), then combined into
// a top-level arrangement that follows the same progSwitchCycles timing as Function 1.

// ARP (4 melodies + silence, both progressions)
const arpMel_prog1 = arrange(
  [arpSwitchCycles, prog1_arpMel_1],
  [arpSwitchCycles, prog1_arpMel_2],
  [arpSwitchCycles, prog1_arpMel_3],
  [arpSwitchCycles, prog1_arpMel_4],
  [arpSwitchCycles, prog_null],
)
const arpMel_prog2 = arrange(
  [arpSwitchCycles, prog2_arpMel_1],
  [arpSwitchCycles, prog2_arpMel_2],
  [arpSwitchCycles, prog2_arpMel_3],
  [arpSwitchCycles, prog2_arpMel_4],
  [arpSwitchCycles, prog_null],
)
const activeArpMel = arrange(
  [progSwitchCycles, arpMel_prog1],
  [progSwitchCycles, arpMel_prog2],
)

// STACCATO (prog1 has 3 melodies, prog2 has 2 - arrangements sized to match)
const staccMel_prog1 = arrange(
  [staccSwitchCycles, prog1_staccMel_1],
  [staccSwitchCycles, prog1_staccMel_2],
  [staccSwitchCycles, prog1_staccMel_3],
  [staccSwitchCycles, prog_null],
)
const staccMel_prog2 = arrange(
  [staccSwitchCycles, prog2_staccMel_1],
  [staccSwitchCycles, prog2_staccMel_2],
  [staccSwitchCycles, prog_null],
)
const activeStaccMel = arrange(
  [progSwitchCycles, staccMel_prog1],
  [progSwitchCycles, staccMel_prog2],
)

// SUSTAIN (2 melodies + silence, both progressions)
const susMel_prog1 = arrange(
  [sustainSwitchCycles, prog1_susMel_1],
  [sustainSwitchCycles, prog1_susMel_2],
  [sustainSwitchCycles, prog_null],
)
const susMel_prog2 = arrange(
  [sustainSwitchCycles, prog2_susMel_1],
  [sustainSwitchCycles, prog2_susMel_2],
  [sustainSwitchCycles, prog_null],
)
const activeSusMel = arrange(
  [progSwitchCycles, susMel_prog1],
  [progSwitchCycles, susMel_prog2],
)


//-----Progression_Players-------------------//
Player_mainChord: activeMainChord
  .s("supersaw")
  .postgain(1.5)
  .transpose(12)
  .lpf(500)
  .room(0.8)
  .chorus(0.4)

Player_mainArp: activeMainArp
  .s("gm_lead_6_voice")
  .postgain(1.5).transpose(24)
  .lpf(rand.range(400,2000))
  .room(1.5)

Player_accMel_arp: activeArpMel
  .s("gm_glockenspiel")
  .postgain(2.5)
  .transpose(24)
  .lpf(3000)
  .room(0)
  .delay(0.2)
  .pan(0.2)

Player_accMel_stacc: stack(
  activeStaccMel
  .s("gm_voice_oohs")
  .detune(0.1)
  .attack(0)
  .decay(3)
  .sustain(0)
  .release(0)
  .lpf(8500)
  .room(0.5)
  .phaser(0)
  .pan(0.6)
  .postgain(0.5), 
  activeStaccMel
  .s("sine")
  .attack(0)
  .decay(3)
  .sustain(0)
  .release(0)
  .distort(0.5)
  .lpf(10000)
  .room(0.3)
  .phaser(0)
  .pan(0.6)
  .postgain(1.2), 
  activeStaccMel
  .s("gm_marimba")
  .detune(0.2)
  .attack(0)
  .decay(3)
  .sustain(0)
  .release(0)
  .lpf(10000)
  .room(0.5)
  .phaser(0)
  .pan(0.6)
  .postgain(0.2),
) 
Player_accMel_sustain: activeSusMel
  .s("gm_harmonica")
  .postgain(1.2)
  .lpf(4000)
  .room(0.5)
  .chorus(0.5)
  .pan(0.6)
